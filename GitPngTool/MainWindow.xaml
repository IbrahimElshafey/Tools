<Window
    x:Class="GitPngTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="850"
    Height="600"
    Title="Git Commit PNG Packer">
    <Grid>
        <!-- Main Content -->
        <Grid Margin="10">
            <TabControl>
                <!-- ENCODE TAB -->
                <TabItem Header="Encode (Git to PNG)">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Repo Path Selector -->
                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Text="Git Repo Path:" />
                            <TextBox
                                x:Name="TxtRepoPath"
                                Width="550"
                                Height="25"
                                VerticalContentAlignment="Center" />
                            <Button
                                x:Name="BtnLoadCommits"
                                Width="100"
                                Height="25"
                                Margin="10,0,0,0"
                                Click="BtnLoadCommits_Click"
                                Content="Load Commits" />
                        </StackPanel>

                        <!-- Commits List Header -->
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,0,0,5"
                            FontWeight="Bold"
                            Text="Latest 100 Commits:" />

                        <!-- Commits DataGrid -->
                        <DataGrid
                            x:Name="DgCommits"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding Hash}"
                                    Header="Commit Hash" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Message}"
                                    Header="Message" />
                                <DataGridTextColumn
                                    Width="160"
                                    Binding="{Binding Date, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}"
                                    Header="Date" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Process Button -->
                        <Button
                            x:Name="BtnProcessEncode"
                            Grid.Row="3"
                            Height="35"
                            Margin="0,10,0,0"
                            Click="BtnProcessEncode_Click"
                            Content="Process &amp; Generate Image"
                            FontWeight="Bold" />
                    </Grid>
                </TabItem>

                <!-- DECODE TAB -->
                <TabItem Header="Decode (PNG to Repo)">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Text="Target Repo Path:" />
                            <TextBox
                                x:Name="TxtDecodeRepoPath"
                                Width="550"
                                Height="25"
                                VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Text="Select PNG Image:" />
                            <TextBox
                                x:Name="TxtPngPath"
                                Width="550"
                                Height="25"
                                VerticalContentAlignment="Center" />
                            <Button
                                Width="80"
                                Height="25"
                                Margin="10,0,0,0"
                                Click="BtnBrowsePng_Click"
                                Content="Browse..." />
                        </StackPanel>

                        <TextBox
                            x:Name="TxtLog"
                            Grid.Row="2"
                            Background="#F4F4F4"
                            FontFamily="Consolas"
                            IsReadOnly="True"
                            VerticalScrollBarVisibility="Auto" />

                        <Button
                            x:Name="BtnProcessDecode"
                            Grid.Row="3"
                            Height="35"
                            Margin="0,10,0,0"
                            Click="BtnProcessDecode_Click"
                            Content="Decode &amp; Apply Changes"
                            FontWeight="Bold" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Loading Overlay Modal Container -->
        <Grid
            x:Name="LoadingOverlay"
            Background="#A0000000"
            Visibility="Collapsed">
            <Border
                Width="380"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="0.3"
                        ShadowDepth="3" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock
                        x:Name="TxtLoadingMessage"
                        Margin="0,0,0,15"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Processing, please wait..."
                        TextWrapping="Wrap" />
                    <ProgressBar
                        x:Name="ProgressBarEncoding"
                        Height="18"
                        IsIndeterminate="True"
                        Maximum="100"
                        Minimum="0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>